  "narrative": {
    "northStar": "A pocket garden guide",
    "overview": "Astana Walk is a calm botanical field guide for an urban walk. A light sage ground, white surfaces and restrained deep teal make the map and nearby places easy to read outdoors. Real map geometry and numbered recommendations are the visual material; familiar controls and progressive disclosure keep the interface approachable.\n\nThe Russian-first identity uses self-hosted Manrope with Cyrillic and Latin coverage. The original A/walking-path SVG and one Lucide outline icon family support the same quiet voice. Motion provides feedback through presses, disclosure and changed result positions; it does not stage a page entrance.",
    "keyCharacteristics": [
      "Sage ground, white panels and a limited teal accent.",
      "Readable Cyrillic typography with compact metadata.",
      "Real geography linked to numbered recommendation cards.",
      "Flat surfaces with small shadows only on map markers and overlays."
    ],
    "rules": [
      {
        "name": "The Map Meaning Rule",
        "body": "Water and park colors describe source geometry; teal identifies actions and selection.",
        "section": "colors"
      },
      {
        "name": "The Readable Numbers Rule",
        "body": "Use tabular numerals for durations, distances, ranks and radius values. Keep compact metadata at the implemented minimum of 11px; do not shrink it to fit.",
        "section": "typography"
      },
      {
        "name": "The Flat Panel Rule",
        "body": "Main planner and recommendation cards stay shadow-free; shadows identify objects floating above the map or form.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve Cyrillic-capable, self-hosted Manrope and readable metadata.",
      "Do pair map ranks with the same numbered cards and expose selection in control semantics.",
      "Do retain source attribution and label uncertain facts, suggested activities and estimated times.",
      "Do keep focus visible and honor reduced-motion preferences.",
      "Do use the sage/white surface hierarchy and restrained teal actions."
    ],
    "donts": [
      "Don't turn the search-radius circle into an implied walking route.",
      "Don't introduce fabricated venues, decorative fake charts or confidence percentages.",
      "Don't add shadows to the main planner and recommendation cards.",
      "Don't replace the compact Cyrillic heading with a giant type specimen or Latin-only face.",
      "Don't hide stale results or missing-data states behind reassuring visual badges."
    ]
  }
}
