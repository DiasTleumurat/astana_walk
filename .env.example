# No key is required for the local demo.
LLM_PROVIDER=gemini
GEMINI_API_KEY=AIzaSyB5Lg5NaA2ONdf6BwF2NTwl3GmAo9p5WGw
GEMINI_MODEL=gemini-3.5-flash-lite
# Enable only if Google Search grounding is available on your account/tier.
GEMINI_GOOGLE_SEARCH=false
LIVE_PLACE_SEARCH=true
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SEMANTIC_SEARCH=true
WALK_SPEED_KMH=4.5
WALK_DETOUR_FACTOR=1.3
# Number of reverse proxies in front of the app (e.g. 1 behind nginx/Render).
# Keep 0 when clients connect directly, otherwise X-Forwarded-For can be spoofed.
TRUSTED_PROXY_HOPS=0

# Optional OSRMRoute API key (server only)
OSRMROUTE_API_KEY=

# 2GIS Places API key (server only)
TWOGIS_API_KEY=
